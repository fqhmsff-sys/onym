{
  "appId": "id.onym.app",
  "appName": "Onym",
  "webDir": "www",
  "backgroundColor": "#FFFFFF",
  "android": { "allowMixedContent": false, "webContentsDebuggingEnabled": false, "backgroundColor": "#FFFFFF" },
  "ios": { "contentInset": "never", "backgroundColor": "#FFFFFF", "limitsNavigationsToAppBoundDomains": false },
  "server": { "androidScheme": "https", "cleartext": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "backgroundColor": "#FFFFFF", "androidScaleType": "CENTER", "showSpinner": false, "launchAutoHide": true },
    "StatusBar": { "style": "DEFAULT", "overlaysWebView": true }
  }
}
