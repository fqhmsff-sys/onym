{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hulhup",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Hubungkan domain lewat dashboard Cloudflare (Workers & Pages → hulhup → Domains)
  // atau tambahkan: "routes": [{ "pattern": "hulhup.my.id", "custom_domain": true }]
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hulhup",
      // Isi setelah `npx wrangler d1 create hulhup`
      "database_id": "GANTI-DENGAN-DATABASE-ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "hulhup-media" }]
}
