{
  "name": "@onym/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply onym --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply onym --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test --test-reporter=spec test/api.test.ts",
    "serve:test": "tsx test/serve.ts 8787"
  },
  "dependencies": { "@onym/shared": "*" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.19.0", "typescript": "^5.6.0", "wrangler": "^4.0.0" }
}
