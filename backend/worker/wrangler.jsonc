{
  "name": "onym",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": {
    "SUPABASE_URL": "https://fttskmwqaskavoortvka.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_NedUHCSmv-K6X99_H10X6g_kKPsFEcU"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "onym-edge", "database_id": "c7ccee9a-9cd6-4c3b-9a0e-70ab56f20340" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "ratelimits": [
    { "name": "RL_ANON",   "namespace_id": "2001", "simple": { "limit": 60,  "period": 60 } },
    { "name": "RL_AUTH",   "namespace_id": "2002", "simple": { "limit": 20,  "period": 60 } },
    { "name": "RL_READ",   "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_WRITE",  "namespace_id": "2004", "simple": { "limit": 30,  "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "2005", "simple": { "limit": 10,  "period": 60 } }
  ]
  // Rahasia (wrangler secret put): NEON_DATABASE_URL, AUTH_PEPPER, JWT_SECRET, INTERNAL_SECRET, SUPABASE_SERVICE_KEY, IP_HASH_SALT
}
